{
	"name": "dirlocal",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm --filter @dirlocal/core build && pnpm -r typecheck",
		"dev:up": "pnpm build && docker compose -f examples/directus/docker-compose.yml up -d --build --wait",
		"dev:down": "docker compose -f examples/directus/docker-compose.yml down",
		"dev:reset": "docker compose -f examples/directus/docker-compose.yml down -v",
		"dev:seed": "node examples/directus/seed.ts",
		"test": "pnpm -r --workspace-concurrency=1 test",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3"
	}
}
